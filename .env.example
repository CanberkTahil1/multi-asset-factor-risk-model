# Copy to .env and fill in real values. .env is gitignored and must never be
# committed. Secrets are read from the environment at runtime — never a literal
# in code, and never a default value in the source.

# FRED (Federal Reserve Economic Data) API key.
# Free, request one at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_fred_api_key_here

# SEC EDGAR fair-access policy: every request must carry a User-Agent naming the
# requester and a contact address, in the form "Name or Org contact@example.com".
# Read by mafrm.data.loaders.fetch_edgar_shares (config: equity_shares.user_agent_env).
# No key to request; any honest contact string is accepted.
SEC_EDGAR_USER_AGENT=Your Name your.email@example.com
